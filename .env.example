# Copy to .env.local. Local demo is explicit and NEVER works on Vercel/production.
LOCAL_DEMO=true
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Public site origin (no trailing slash). PayU/Razorpay callbacks and email links use this.
APP_URL=http://localhost:4170
# Use an authenticated sender before email delivery.
RESEND_API_KEY=
EMAIL_FROM=
# Alias accepted if EMAIL_FROM is empty:
# RESEND_FROM_EMAIL=
CRON_SECRET=
# Default false: local mode never sends even if this is set.
EMAIL_DELIVERY_ENABLED=false
# Optional local-only testing (ignored when NODE_ENV is not development or on Vercel):
# EMAIL_TEST_RECIPIENT=
# STAFF_ALERT_EMAILS=
# Vercel cron (vercel.json) hits GET /api/jobs every 5m with Authorization: Bearer CRON_SECRET
# to process the delivery queue (staff alerts, confirmations, thank-you, cart recovery).
LINK_SIGNING_SECRET=
# OpenAI sales assistant: server-only. Requires your API project and billing.
OPENAI_API_KEY=
OPENAI_ASSISTANT_ENABLED=false
OPENAI_MODEL=gpt-4.1-mini
OPENAI_DAILY_REQUEST_LIMIT=200

# --- Razorpay (optional) ---
# Test/live keys from Razorpay Dashboard. Webhook: POST {APP_URL}/api/payments/webhook
RAZORPAY_ENABLED=false
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- PayU Hosted Checkout (optional) ---
# Official: https://docs.payu.in/docs/prebuilt-checkout-page-integration
# Test key + Salt v1: https://docs.payu.in/docs/generate-test-merchant-key-and-salt
# PAYU_MODE=test  → POST https://test.payu.in/_payment
# PAYU_MODE=live  → POST https://secure.payu.in/_payment
# surl/furl (auto): {APP_URL}/api/payments/payu/callback — must be public HTTPS for real PayU tests
PAYU_ENABLED=false
PAYU_MERCHANT_KEY=
PAYU_MERCHANT_SALT=
PAYU_MODE=test

# Checkout provider when Admin has not published paymentGateway yet: razorpay | payu
# After publish, use Admin → Settings → Plans & checkout → Payment gateway
PAYMENT_GATEWAY=razorpay

# Full PayU checklist: docs/PAYU_SETUP.md
